  "components": {
    "schemas": {
      "CinemaAdminRequest": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Name"
          },
          "address": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Address"
          },
          "city": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "City"
          }
        },
        "type": "object",
        "required": [
          "name",
          "address",
          "city"
        ],
        "title": "CinemaAdminRequest"
      },
      "CreateOrderRequest": {
        "properties": {
          "seatIds": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "maxItems": 8,
            "minItems": 1,
            "title": "Seatids"
          },
          "scheduleId": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Scheduleid"
          },
          "idempotencyKey": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Idempotencykey"
          }
        },
        "type": "object",
        "required": [
          "seatIds",
          "scheduleId",
          "idempotencyKey"
        ],
        "title": "CreateOrderRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LockSeatsRequest": {
        "properties": {
          "seatIds": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "maxItems": 8,
            "minItems": 1,
            "title": "Seatids"
          }
        },
        "type": "object",
        "required": [
          "seatIds"
        ],
        "title": "LockSeatsRequest"
      },
      "LoginRequest": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 32,
            "minLength": 1,
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 72,
            "minLength": 1,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "LoginRequest"
      },
      "MovieAdminRequest": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Name"
          },
          "genres": {
            "type": "string",
            "maxLength": 255,
            "title": "Genres",
            "default": ""
          },
          "regions": {
            "type": "string",
            "maxLength": 255,
            "title": "Regions",
            "default": ""
          },
          "releaseYear": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 2200.0,
                "minimum": 1888.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Releaseyear"
          },
          "score": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 10.0,
                "minimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              }
            ],
            "title": "Score",
            "default": 0
          },
          "status": {
            "type": "string",
            "pattern": "^(AVAILABLE|OFF_SHELF)$",
            "title": "Status",
            "default": "AVAILABLE"
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "MovieAdminRequest"
      },
      "PaymentCallbackRequest": {
        "properties": {
          "providerTradeNo": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Providertradeno"
          },
          "success": {
            "type": "boolean",
            "title": "Success"
          }
        },
        "type": "object",
        "required": [
          "providerTradeNo",
          "success"
        ],
        "title": "PaymentCallbackRequest"
      },
      "RegisterRequest": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 32,
            "minLength": 3,
            "pattern": "^[A-Za-z0-9_]+$",
            "title": "Username"
          },
          "phone": {
            "type": "string",
            "pattern": "^1[3-9]\\d{9}$",
            "title": "Phone"
          },
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 72,
            "minLength": 6,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "username",
          "phone",
          "email",
          "password"
        ],
        "title": "RegisterRequest"
      },
      "ReviewRequest": {
        "properties": {
          "rating": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 10.0,
                "minimum": 1.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,2}|(?=[\\d.]{1,4}0*$)\\d{0,2}\\.\\d{0,1}0*$)"
              }
            ],
            "title": "Rating"
          },
          "content": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Content"
          }
        },
        "type": "object",
        "required": [
          "rating",
          "content"
        ],
        "title": "ReviewRequest"
      },
      "ScheduleAdminRequest": {
        "properties": {
          "movieId": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Movieid"
          },
          "cinemaId": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Cinemaid"
          },
          "hallName": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Hallname"
          },
          "startTime": {
            "type": "string",
            "title": "Starttime"
          },
          "endTime": {
            "type": "string",
            "title": "Endtime"
          },
          "price": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,8}|(?=[\\d.]{1,11}0*$)\\d{0,8}\\.\\d{0,2}0*$)"
              }
            ],
            "title": "Price"
          },
          "rows": {
            "type": "integer",
            "maximum": 26.0,
            "minimum": 1.0,
            "title": "Rows",
            "default": 5
          },
          "seatsPerRow": {
            "type": "integer",
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "Seatsperrow",
            "default": 10
          }
        },
        "type": "object",
        "required": [
          "movieId",
          "cinemaId",
          "hallName",
          "startTime",
          "endTime",
          "price"
        ],
        "title": "ScheduleAdminRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}